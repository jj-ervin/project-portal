{
  "name": "propro-dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "desktop:package": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cockpit/gui": "file:vendor/cockpit-gui-0.1.4.tgz",
    "@governancecommons/observatory-core": "file:vendor/observatory-core-0.1.4.tgz"
  },
  "build": {
    "appId": "org.propro.desktop",
    "productName": "ProPro",
    "asar": false,
    "directories": {"output": "release"},
    "files": [
      "desktop/**", "app.mjs", "agent-manager-model.js", "agent-manager-ui.js", "chat-client.mjs", "chat-service.mjs", "newsroom-ui.js", "theme-registry.js", "themes.css",
      "index.html", "model.mjs", "ollama.mjs", "open-resource.ps1", "agent-runs.mjs", "agent-runs-ui.js",
      "server.mjs", "git-status.mjs", "ide-launch.mjs", "bootdog-workflow.mjs", "workflow-ui/**",
      "styles.css", "node_modules/@cockpit/gui/**", "node_modules/@governancecommons/observatory-core/**"
    ],
    "win": {"target": [{"target": "portable", "arch": ["x64"]}]}
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.14.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  }
}
